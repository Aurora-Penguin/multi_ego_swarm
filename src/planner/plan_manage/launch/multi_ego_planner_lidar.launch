<launch>
    <group ns="drone_0">
        <remap from="/position_cmd" to="position_cmd" />
        <include file="$(find ego_planner)/launch/single_run_in_gazebo_lidar.launch">

            <arg name="drone_id" value="0"/>
            <arg name="target0_x" value="30.0"/>
            <arg name="target0_y" value="4.0"/>
            <arg name="target0_z" value="1.5"/>
        </include>
    </group>

    <group ns="drone_1">
        <remap from="/position_cmd" to="position_cmd" />
        <include file="$(find ego_planner)/launch/single_run_in_gazebo_lidar.launch">
            <arg name="drone_id" value="1"/>
            <arg name="target0_x" value="30.0"/>
            <arg name="target0_y" value="0.0"/>
            <arg name="target0_z" value="1.5"/>
        </include>
    </group>

    <group ns="drone_2">
        <remap from="/position_cmd" to="position_cmd" />
        <include file="$(find ego_planner)/launch/single_run_in_gazebo_lidar.launch">
            <arg name="drone_id" value="2"/>
            <arg name="target0_x" value="30.0"/>
            <arg name="target0_y" value="-4.0"/>
            <arg name="target0_z" value="1.5"/>
        </include>
    </group>

    <include file="$(find assign_goals)/launch/assign_goals.launch"/>

    <include file="$(find ego_planner)/launch/rviz.launch"/>

    <!-- UDP bridge for trajectory broadcasting between drones -->
    <include file="$(find swarm_bridge)/launch/bridge_udp.launch">
        <arg name="drone_id" value="999"/>
        <arg name="broadcast_ip" value="127.0.0.255"/>
    </include>

</launch>