<launch>
<!--static_transform_publisher x y z yaw pitch roll frame_id child_frame_id period_in_ms，其中 x y z 是 x y z 的坐标， yaw pitch roll 是 绕 z旋转弧度角，绕y旋转弧度角，绕x旋转弧度角，
	frame_id child_frame_id period_in_ms 父坐标系，子坐标系，发布间隔（ms)-->
	<node pkg="tf" type="static_transform_publisher" name="base_link_to_3d_lidar" args="0 0 0.2 0 0 0 /base_link /laser_3d 100"/>
</launch>